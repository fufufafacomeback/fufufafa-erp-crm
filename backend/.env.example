# Backend environment
# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string. Include the database name.
DATABASE="mongodb://user:password@localhost:27017/idurar?authSource=admin"

# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Email (Resend) API key - optional
RESEND_API=""

# OpenAI API key - optional
OPENAI_API_KEY=""

# development | production
NODE_ENV="development"

# Absolute URL of this backend, used to build public asset links
PUBLIC_SERVER_FILE="http://localhost:8888/"
